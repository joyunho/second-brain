# YouKnow 연동 키 — 이 파일을 .env 로 복사해 채우세요. .env 는 .gitignore 에 있어 커밋되지 않습니다.
#   cp _System/Scripts/.env.example _System/Scripts/.env

# Supabase 프로젝트 URL (앱 번들의 NEXT_PUBLIC_SUPABASE_URL 과 같은 값)
YK_SUPABASE_URL=https://kvplcqfxgjqochsqgisf.supabase.co

# anon key (앱 번들에 공개된 값이지만 저장소에는 넣지 않습니다 — 앱 설정 → 문제 진단, 또는 번들에서 복사)
YK_SUPABASE_ANON_KEY=

# 소유자 id (앱 NEXT_PUBLIC_OWNER_ID; 기본값 그대로면 비워 둬도 됩니다)
YK_OWNER_ID=00000000-0000-0000-0000-000000000001

# 앱 주소 — yk_url 딥링크와 --push-pending(/api/capture)에 사용
YK_APP_URL=https://youknow-meta-data-weom.vercel.app

# Vercel 에 WIDGET_KEY 를 두었다면 같은 값 (--push-pending 과 위젯·단축어용). 비워 두면 키 없이 보냅니다.
YK_WIDGET_KEY=

# 테스트용: 오늘 날짜 고정 (YYYY-MM-DD). 평소에는 비워 둡니다.
# YK_TODAY=2026-10-16
